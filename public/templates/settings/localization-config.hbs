<section>
  <h4>{{localize "lancer.setting.localization.cache.header"}}</h4>
  {{#if cache.length}}
    {{#each cache as |entry|}}
      <fieldset>
        <legend>{{entry.locale}}</legend>
        {{#each entry.packs as |pack|}}
          <div class="form-group flexrow">
            <label>{{pack}}</label>
            <button type="button" data-action="deleteLLPEntry" data-locale="{{entry.locale}}" data-pack="{{pack}}"
              data-tooltip="{{localize "lancer.setting.localization.cache.delete"}}">
              <i class="fas fa-trash"></i>
            </button>
          </div>
        {{/each}}
      </fieldset>
    {{/each}}
  {{else}}
    <p class="notes">{{localize "lancer.setting.localization.cache.empty"}}</p>
  {{/if}}
</section>
