<form class="{{cssClass}}" autocomplete="off">
  {{! Sheet Header }}
  <header class="sheet-header card clipped-bot">
    <h1 class="name">
      <input
        class="lancer-input header-field"
        name="name"
        type="text"
        value="{{item.name}}"
        placeholder="{{localize 'lancer.placeholder.name'}}"
      >
    </h1>
    {{{ref-portrait-img item.img "img" item}}}
    <div class="header-details">
      {{{item-edit-license}}}
    </div>
  </header>

  {{! Sheet Body }}
  <section class="sheet-body flexrow sheet-weapon-mod">
    <div class="flexcol" style="flex-basis: 66%">
      {{{item-edit-effect "system.effect"}}}
      {{{item-edit-arrayed-actions "system.actions" (upper-case (localize "lancer.mech-sheet.weapon-mod.added-actions.label"))}}}
      {{{item-edit-arrayed-damage "system.added_damage" (upper-case (localize "lancer.mech-sheet.weapon-mod.added-damage.label"))}}}
      {{{item-edit-arrayed-range "system.added_range" (upper-case (localize "lancer.mech-sheet.weapon-mod.added-range.label"))}}}
      {{{item-edit-arrayed-tags "system.added_tags" (upper-case (localize "lancer.mech-sheet.weapon-mod.added-tags.label"))}}}
      {{{item-edit-arrayed-bonuses "system.bonuses"}}}
      <div class="flexrow">
        {{{counter-array system.counters "system.counters" true}}}
      </div>
      {{{item-edit-arrayed-deployables "system.deployables" (upper-case (localize "lancer.mech-sheet.weapon-mod.added-deployables.label"))}}}
      {{{item-edit-arrayed-synergies "system.synergies" (upper-case (localize "lancer.common-sheet.synergies.label"))}}}
      {{{item-edit-arrayed-integrated "system.integrated" (upper-case (localize "lancer.common-sheet.integrated-items.label"))}}}
      {{{item-edit-arrayed-tags "system.tags" (upper-case (localize "lancer.common.descriptor.tag.plural"))}}}
    </div>
    <div class="flexcol" style="flex-basis: 33%">
      {{{item-edit-sp "system.sp"}}}
      {{#if (is-limited item)}}
        {{{limited-uses-indicator item "item"}}}
      {{/if}}
      {{{item-edit-checkboxes-object (localize "lancer.item-sheet.weapon-mod.allowed-sizes.label") "system.allowed_sizes"}}}
      {{{item-edit-checkboxes-object (localize "lancer.item-sheet.weapon-mod.allowed-types.label") "system.allowed_types"}}}
    </div>
  </section>
</form>
